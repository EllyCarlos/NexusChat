# Application
NODE_ENV="production"
PORT="5000"
# Optional exact Vercel deployment origin. A hostname-only *.vercel.app value
# is normalized to HTTPS; custom frontend domains belong in application config.
# VERCEL_URL="your-deployment.vercel.app"

# Database (server-only)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"

# Authentication (server-only)
JWT_SECRET="replace-with-a-long-random-secret"
JWT_TOKEN_EXPIRATION_DAYS="30"
OTP_EXPIRATION_MINUTES="10"
PASSWORD_RESET_TOKEN_EXPIRATION_MINUTES="60"

# Operational metrics (disabled by default). A dedicated bearer credential of
# at least 32 characters is required only when METRICS_ENABLED="true".
METRICS_ENABLED="false"
# METRICS_BEARER_TOKEN="replace-with-a-dedicated-random-metrics-token"

# OAuth (server-only)
GOOGLE_CLIENT_ID="replace-with-google-oauth-client-id"
GOOGLE_CLIENT_SECRET="replace-with-google-oauth-client-secret"
# Required unconditionally by the current env schema.
GOOGLE_APPLICATION_CREDENTIALS="./path/to/google-application-credentials.json"

# Email (server-only Gmail credentials)
EMAIL="developer@example.com"
PASSWORD="replace-with-an-email-app-password"

# Firebase Admin (server-only production credentials)
FIREBASE_PROJECT_ID="replace-with-firebase-project-id"
FIREBASE_CLIENT_EMAIL="firebase-admin@example.invalid"
FIREBASE_PRIVATE_KEY="replace-with-escaped-firebase-private-key"

# Cloudinary (server-only)
CLOUDINARY_CLOUD_NAME="replace-with-cloudinary-cloud-name"
CLOUDINARY_API_KEY="replace-with-cloudinary-api-key"
CLOUDINARY_API_SECRET="replace-with-cloudinary-api-secret"

# Optional frontend URL overrides used by backend-generated email links.
# FRONTEND_URL="https://your-frontend.example.com"
# CLIENT_URL="https://your-frontend.example.com"
