# Application
# NODE_ENV must also be set before startup so the loader selects this file.
NODE_ENV="DEVELOPMENT"
PORT="5000"

# Database (server-only)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"

# Authentication (server-only)
JWT_SECRET="replace-with-a-long-random-secret"
JWT_TOKEN_EXPIRATION_DAYS="30"
OTP_EXPIRATION_MINUTES="10"
PASSWORD_RESET_TOKEN_EXPIRATION_MINUTES="60"

# OAuth (server-only)
GOOGLE_CLIENT_ID="replace-with-google-oauth-client-id"
GOOGLE_CLIENT_SECRET="replace-with-google-oauth-client-secret"
# Required by the current env schema even though development Firebase loads
# backend/firebase-admin-cred.json directly.
GOOGLE_APPLICATION_CREDENTIALS="./path/to/google-application-credentials.json"

# Email (server-only Gmail credentials)
EMAIL="developer@example.com"
PASSWORD="replace-with-an-email-app-password"

# Cloudinary (server-only)
CLOUDINARY_CLOUD_NAME="replace-with-cloudinary-cloud-name"
CLOUDINARY_API_KEY="replace-with-cloudinary-api-key"
CLOUDINARY_API_SECRET="replace-with-cloudinary-api-secret"

# Optional frontend URL overrides used by backend-generated email links.
# FRONTEND_URL="http://localhost:3000"
# CLIENT_URL="http://localhost:3000"
