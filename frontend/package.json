{
  "name": "my-app",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.x",
    "npm": "11.x"
  },
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint .",
    "db:push:dev": "dotenv -e .env.development -- npx prisma db push",
    "db:push:prod": "dotenv -e .env.production -- npx prisma db push",
    "migrate:dev": "dotenv -e .env.development -- npx prisma migrate deploy",
    "migrate:prod": "dotenv -e .env.production -- npx prisma migrate deploy",
    "postinstall": "prisma generate",
    "test": "vitest run",
    "ts.check": "next typegen && tsc --noEmit",
    "test:security": "vitest run tests/token-purpose.test.ts tests/oauth-session-flow.test.ts"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.9.1",
    "@prisma/client": "^6.3.1",
    "@reduxjs/toolkit": "^2.5.0",
    "bcryptjs": "^2.4.3",
    "date-fns": "^4.1.0",
    "emoji-picker-react": "^4.12.0",
    "firebase": "^11.3.1",
    "framer-motion": "^11.17.0",
    "gif-picker-react": "^1.4.0",
    "jose": "^5.9.6",
    "lottie-react": "^2.4.0",
    "next": "16.3.2",
    "nodemailer": "9.0.5",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.54.2",
    "react-hot-toast": "^2.5.1",
    "react-redux": "^9.2.0",
    "react-sound-visualizer": "^1.4.0",
    "server-only": "^0.0.1",
    "socket.io-client": "^4.8.1",
    "sonner": "^1.7.4",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/nodemailer": "^6.4.17",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv-cli": "^8.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.3.2",
    "postcss": "^8",
    "prisma": "^6.3.1",
    "tailwindcss": "^3.4.1",
    "typescript": "^5",
    "vitest": "^4.1.11"
  }
}
