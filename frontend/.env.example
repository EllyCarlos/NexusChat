# Database (server-only; required by Prisma)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"
SHADOW_DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/SHADOW_DATABASE?schema=public"

# Authentication and recovery (server-only)
JWT_SECRET="replace-with-a-long-random-secret"
PRIVATE_KEY_RECOVERY_KEK_V1="replace-with-base64-encoded-32-byte-key"
# Optional: required only while legacy OAuth private-key backups still exist.
# PRIVATE_KEY_RECOVERY_SECRET="replace-with-a-long-random-secret"

# Email (server-only Gmail credentials)
EMAIL="developer@example.com"
PASSWORD="replace-with-an-email-app-password"

# Public application and backend URLs (exposed to browser code)
NEXT_PUBLIC_CLIENT_URL="http://localhost:3000"
NEXT_PUBLIC_API_URL="http://localhost:5000"
NEXT_PUBLIC_BASE_URL="http://localhost:5000/api/v1"
NEXT_PUBLIC_ABSOLUTE_BASE_URL="http://localhost:5000"

# Public Firebase web configuration (exposed to browser code)
NEXT_PUBLIC_FIREBASE_API_KEY="replace-with-firebase-web-api-key"
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="your-project.firebaseapp.com"
NEXT_PUBLIC_FIREBASE_PROJECT_ID="your-project-id"
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET="your-project.firebasestorage.app"
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID="replace-with-messaging-sender-id"
NEXT_PUBLIC_FIREBASE_APP_ID="replace-with-firebase-app-id"
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID="replace-with-measurement-id"
NEXT_PUBLIC_FIREBASE_FCM_VAPID_KEY="replace-with-firebase-web-push-vapid-key"

# Public GIF search credential (exposed to browser code)
NEXT_PUBLIC_TENOR_API_KEY="replace-with-tenor-api-key"
